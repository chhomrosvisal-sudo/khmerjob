DATABASE_URL=mysql+pymysql://khmer_app:change_me@127.0.0.1:3306/khmer_job_matcher?charset=utf8mb4
FRONTEND_ORIGIN=http://localhost:5173
# Generate a unique random secret; see README. Never reuse the test secret.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
# Optional real password recovery. Configure privately; never commit passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
RATE_LIMIT_ENABLED=true
# auto uses scikit-learn when installed; sklearn requires it; builtin is the dependency-free implementation.
ML_ENGINE=auto
# Optional private model directory; defaults to backend/.local_models.
ML_MODEL_DIR=
# Optional Google/Facebook OAuth. Keep secrets here, never in frontend .env.
# Register FRONTEND_ORIGIN + /oauth/callback as the exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Use the supported version selected in your Meta app, for example vXX.0.
FACEBOOK_GRAPH_VERSION=
